# MapTiler Basemap (Free tier API key for Dataviz Light & Dark vector tiles)
# Get a key at https://cloud.maptiler.com/account/keys/
# Recommended: Restrict key by allowed HTTP origins in the MapTiler Cloud console.
VITE_MAPTILER_KEY=

# Supabase Authentication (managed auth provider)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Assistant Proxy (Server-side only — never bundled into client)
GEMINI_API_KEY=your_gemini_api_key_here
